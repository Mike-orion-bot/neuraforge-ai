# --- MOTOR DE ACTUALIZACIÓN (GIT-SYNC) ---
def trigger_self_update():
    """La entidad revisa mejoras en Git y se auto-repara/actualiza"""
    try:
        logger.info("🔄 Revisando actualizaciones en GitHub...")
        # Ejecuta git pull
        process = subprocess.Popen(['git', 'pull'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        stdout, stderr = process.communicate()
        
        if "Already up to date" not in stdout:
            logger.info("🚀 Nueva versión detectada. Reiniciando núcleo...")
            # Reinicia el proceso actual
            os.execv(sys.executable, ['python'] + sys.argv)
        return stdout
    except Exception as e:
        logger.error(f"❌ Fallo en actualización: {e}")
        return str(e)

# --- BASE DE DATOS ---
def get_db_connection():
    conn = sqlite3.connect(DB_NAME)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db_connection()
    # Tabla de usuarios y licencias (Número de Serie)
    conn.execute('''CREATE TABLE IF NOT EXISTS users
                    (id INTEGER PRIMARY KEY AUTOINCREMENT,
                     telegram_id TEXT UNIQUE,
                     username TEXT,
                     serial_key TEXT,
                     bot_type TEXT,
                     is_active INTEGER DEFAULT 1)''')
    conn.commit()
    conn.close()

init_db()

